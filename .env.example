# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Places / Gemini
GOOGLE_PLACES_API_KEY=your-google-places-key
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# Upstash Redis (tùy chọn ở dev: thiếu thì dùng cache bộ nhớ; bắt buộc ở production)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Giới hạn AI và xếp hạng
AI_DAILY_LIMIT_PER_GROUP=10
AI_MONTHLY_CAP=300
RANK_PRIOR_M=50
EXPLORE_MIN_REVIEWS=20

# TTL cache (giây): Places 1 ngày, tóm tắt AI 14 ngày, hot 7 ngày
PLACES_TTL_SEC=86400
# Tọa độ OpenStreetMap (Nominatim) cache 30 ngày
GEOCODE_TTL_SEC=2592000
# Gợi ý địa chỉ khi gõ (Photon/OpenStreetMap) cache 7 ngày
GEO_SUGGEST_TTL_SEC=604800
AI_SUMMARY_TTL_SEC=1209600
AI_HOT_TTL_SEC=604800

# Phiên bản build, dùng làm buster cho cache client (tùy chọn; mặc định = version trong package.json)
NEXT_PUBLIC_BUILD_ID=

# Cloudinary: lưu tệp ở tab Thông tin (tùy chọn; thiếu thì vẫn dùng ghi chú/link, chỉ tắt tải tệp)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Link xem/tải tệp hết hạn sau (giây)
INFO_FILE_URL_TTL_SEC=300
