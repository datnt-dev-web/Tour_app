# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Places / Gemini
GOOGLE_PLACES_API_KEY=your-google-places-key
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# Upstash Redis (tùy chọn ở dev: thiếu thì dùng cache bộ nhớ; bắt buộc ở production)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Giới hạn AI và xếp hạng
AI_DAILY_LIMIT_PER_GROUP=10
AI_MONTHLY_CAP=300
RANK_PRIOR_M=50
EXPLORE_MIN_REVIEWS=20

# TTL cache (giây): Places 1 ngày, tóm tắt AI 14 ngày, hot 7 ngày
PLACES_TTL_SEC=86400
# Tọa độ OpenStreetMap (Nominatim) cache 30 ngày
GEOCODE_TTL_SEC=2592000
# Gợi ý địa chỉ khi gõ (Photon/OpenStreetMap) cache 7 ngày
GEO_SUGGEST_TTL_SEC=604800
AI_SUMMARY_TTL_SEC=1209600
AI_HOT_TTL_SEC=604800

# Phiên bản build, dùng làm buster cho cache client (tùy chọn; mặc định = mã commit trên Vercel, hoặc version trong package.json khi chạy local)
NEXT_PUBLIC_BUILD_ID=

# Cloudinary: lưu tệp ở tab Thông tin (tùy chọn; thiếu thì vẫn dùng ghi chú/link, chỉ tắt tải tệp)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Link xem/tải tệp hết hạn sau (giây)
INFO_FILE_URL_TTL_SEC=300

# Khám phá: máy chủ Overpass (OpenStreetMap), tùy chọn
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Quãng đường đi thật ở tab Hôm nay: Valhalla (OpenStreetMap), tùy chọn. Phương tiện: motor_scooter (xe máy),
# motorcycle, auto (ô tô), pedestrian (đi bộ), bicycle. Quãng đường cache 30 ngày.
VALHALLA_API_URL=https://valhalla1.openstreetmap.de
ROUTING_COSTING=motor_scooter
ROUTE_TTL_SEC=2592000
# Số lần tính quãng đường tối đa mỗi phút cho một link chia sẻ
SHARE_DISTANCES_PER_MIN=20

# Thông báo đẩy nhắc giờ (Web Push), tùy chọn. Tạo khóa: npx web-push generate-vapid-keys
# VAPID_SUBJECT: mailto:… hoặc URL của app (trình duyệt dùng để liên hệ nếu có sự cố)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=https://your-app.example
# Khóa cho /api/cron/reminders (pg_cron gửi kèm Authorization: Bearer …), tối thiểu 16 ký tự
CRON_SECRET=your-cron-secret-at-least-16-chars
